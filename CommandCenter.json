{
  "initScriptPath": null,
  "validation": {
    "commands": {
      "benchmark-build": {
        "command": {
          "full": "scripts/validate/benchmark-build-full.sh"
        },
        "cost": 2,
        "timeoutMs": 900000,
        "description": "Build release binaries, examples, and benchmarks with two jobs",
        "pathArgs": "forbid"
      },
      "format": {
        "command": {
          "full": "scripts/validate/format-full.sh",
          "changed": "scripts/validate/format-changed.sh"
        },
        "cost": 1,
        "description": "Check Rust formatting",
        "pathArgs": "forbid"
      },
      "lint": {
        "command": {
          "full": "scripts/validate/lint-full.sh"
        },
        "cost": 2,
        "description": "Run Clippy on all Rust targets",
        "pathArgs": "forbid"
      },
      "test": {
        "command": {
          "full": "scripts/validate/test-full.sh",
          "changed": "scripts/validate/test-changed.sh"
        },
        "cost": 2,
        "timeoutMs": 900000,
        "description": "Run Rust tests or explicit integration-test files with two build jobs and two test threads",
        "pathArgs": "paths"
      },
      "harness-test": {
        "command": {
          "full": "scripts/validate/harness-test-full.sh",
          "changed": "scripts/validate/harness-test-changed.sh"
        },
        "cost": 2,
        "timeoutMs": 900000,
        "description": "Run Node harness tests or explicit existing tools/*.test.mjs files with two workers and report skipped tests; HARNESS_REQUIRE_COMPILERS=1 fails on skips",
        "pathArgs": "paths"
      },
      "semantic": {
        "command": {
          "full": "scripts/validate/semantic-full.sh"
        },
        "cost": 2,
        "timeoutMs": 900000,
        "description": "Check fixtures/references against the pinned TypeScript 7.0.2 semantic oracle; exit 2 means the compilers were not found",
        "pathArgs": "forbid"
      }
    },
    "preMerge": ["format", "lint", "test", "harness-test", "semantic"]
  }
}
